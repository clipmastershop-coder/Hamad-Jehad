# انسخ هذا الملف إلى .env.local وضع فيه مفاتيحك الحقيقية (اختياري تمامًا للتشغيل المحلي —
# الموقع ولوحة التحكم يشتغلوا من غير أي إعداد، القاعدة بتتولّد وتتملى تلقائيًا أول تشغيل)

# مفاتيح Stripe (من https://dashboard.stripe.com/apikeys) — لازمة بس وقت تفعيل الدفع الحقيقي
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# رابط موقعك (محلياً أثناء التجربة أو الرابط الحقيقي بعد النشر)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# مفتاح سري عشوائي (لتوقيع روابط التحميل وجلسات الدخول) — غيّره قبل النشر الحقيقي
DOWNLOAD_SECRET=change-this-to-a-long-random-string
SESSION_SECRET=change-this-to-another-long-random-string

# حساب الأدمن الافتراضي (يُنشأ تلقائيًا أول مرة الموقع يشتغل فيها) — غيّر القيمتين دول
# فورًا بعد أول دخول من لوحة التحكم /admin/login
ADMIN_EMAIL=admin@clipmaster.se
ADMIN_PASSWORD=ClipMaster2026!
