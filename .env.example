# انسخ هذا الملف إلى .env.local وضع فيه مفاتيحك الحقيقية

# مفاتيح Stripe (من https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# رابط موقعك (محلياً أثناء التجربة أو الرابط الحقيقي بعد النشر)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# مفتاح سري عشوائي لتوقيع روابط التحميل (غيّره لأي نص طويل عشوائي)
DOWNLOAD_SECRET=change-this-to-a-long-random-string

# Stripe webhook signing secret (من: stripe listen أو إعدادات الـ webhook على dashboard.stripe.com)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Supabase (راجع supabase/README.md لشرح كل خطوة)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxx
